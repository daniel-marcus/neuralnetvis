{
  "name": "neuralnetvis",
  "version": "0.1.5",
  "private": true,
  "description": "Wrap your head around neural networks and watch machines learn",
  "keywords": [
    "data-visualization",
    "machine-learning",
    "neural-network",
    "react",
    "tensorflow",
    "threejs",
    "webgl",
    "webgpu"
  ],
  "homepage": "https://neuralnetvis.app",
  "license": "MIT",
  "author": "Daniel Marcus (https://danielmarcus.de)",
  "repository": "https://github.com/daniel-marcus/neuralnetvis",
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "serve": "npx serve out",
    "lint": "oxlint",
    "lint:fix": "oxlint --fix",
    "typecheck": "tsc --noEmit",
    "fmt": "oxfmt",
    "test": "vitest run",
    "test:watch": "vitest",
    "setup-puppeteer": "pnpm dlx puppeteer browsers install",
    "screenshot": "node --import @swc-node/register/esm-register scripts/screenshot.ts",
    "convert-keras": "node scripts/convert-keras.mts",
    "analyze": "next experimental-analyze",
    "bump": "commit-and-tag-version --no-verify",
    "changelog": "commit-and-tag-version --dry-run",
    "font-to-typeface": "node scripts/font-to-typeface.mts"
  },
  "dependencies": {
    "@deck.gl/core": "^9.4.0",
    "@deck.gl/extensions": "^9.4.0",
    "@deck.gl/layers": "^9.4.0",
    "@deck.gl/react": "^9.4.0",
    "@huggingface/tokenizers": "^0.2.0",
    "@mediapipe/drawing_utils": "^0.3.1675466124",
    "@mediapipe/hands": "^0.4.1675469240",
    "@mediapipe/tasks-vision": "1.1.1",
    "@react-spring/web": "^10.1.2",
    "@react-three/drei": "^10.7.9",
    "@react-three/fiber": "^9.8.2",
    "@tensorflow/tfjs": "^4.22.0",
    "@tensorflow/tfjs-backend-wasm": "^4.22.0",
    "@tensorflow/tfjs-backend-webgpu": "^4.22.0",
    "@tensorflow/tfjs-layers": "^4.22.0",
    "@use-gesture/react": "^10.3.1",
    "figlet": "^1.12.0",
    "idb": "^8.0.4",
    "jsfive": "^0.4.2",
    "jszip": "^3.10.2",
    "lodash.throttle": "^4.1.1",
    "next": "^16.4.2",
    "npyjs": "^1.2.0",
    "r3f-forcegraph": "^1.1.1",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "react-headroom": "^3.2.1",
    "three": "^0.186.1",
    "three-stdlib": "^2.36.1",
    "tunnel-rat": "^0.1.2",
    "zustand": "^5.0.16"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "^4.3.3",
    "@tensorflow/tfjs-node": "^4.22.0",
    "@testing-library/dom": "^10.4.2",
    "@testing-library/react": "^16.3.3",
    "@types/figlet": "^1.7.0",
    "@types/lodash.throttle": "^4.1.9",
    "@types/node": "^26.6.5",
    "@types/opentype.js": "^1.3.10",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@types/react-headroom": "^3.2.3",
    "@types/three": "^0.186.0",
    "@vitejs/plugin-react": "^6.1.2",
    "commit-and-tag-version": "^13.3.0",
    "fake-indexeddb": "^6.2.6",
    "happy-dom": "^21.0.4",
    "lefthook": "^2.2.2",
    "opentype.js": "^2.0.0",
    "oxfmt": "^0.74.0",
    "oxlint": "^1.89.0",
    "patch-package": "^8.0.1",
    "postcss": "^8.5.31",
    "puppeteer": "^25.16.0",
    "tailwindcss": "^4.3.3",
    "typescript": "^6.0.3",
    "vite": "^8.3.5",
    "vitest": "^5.0.5"
  },
  "packageManager": "pnpm@12.15.0",
  "postcss": {
    "plugins": {
      "@tailwindcss/postcss": {}
    }
  }
}
