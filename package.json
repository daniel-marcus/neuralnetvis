{
  "name": "neuralnetvis",
  "version": "0.1.4",
  "private": true,
  "description": "Wrap your head around neural networks and watch machines learn",
  "keywords": [
    "data-visualization",
    "machine-learning",
    "neural-network",
    "react",
    "tensorflow",
    "threejs",
    "webgl",
    "webgpu"
  ],
  "homepage": "https://neuralnetvis.app",
  "license": "MIT",
  "author": "Daniel Marcus (https://danielmarcus.de)",
  "repository": "https://github.com/daniel-marcus/neuralnetvis",
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "serve": "npx serve out",
    "lint": "oxlint",
    "lint:fix": "oxlint --fix",
    "typecheck": "tsc --noEmit",
    "fmt": "oxfmt",
    "test": "vitest run",
    "test:watch": "vitest",
    "setup-puppeteer": "pnpm dlx puppeteer browsers install",
    "screenshot": "node --import @swc-node/register/esm-register scripts/screenshot.ts",
    "analyze": "next experimental-analyze",
    "bump": "commit-and-tag-version --no-verify",
    "changelog": "commit-and-tag-version --dry-run"
  },
  "dependencies": {
    "@deck.gl/core": "^9.3.6",
    "@deck.gl/extensions": "^9.3.6",
    "@deck.gl/layers": "^9.3.6",
    "@deck.gl/react": "^9.3.6",
    "@mediapipe/drawing_utils": "^0.3.1675466124",
    "@mediapipe/hands": "^0.4.1675469240",
    "@mediapipe/tasks-vision": "0.10.35",
    "@react-spring/web": "^10.1.2",
    "@react-three/drei": "^10.7.7",
    "@react-three/fiber": "^9.6.1",
    "@tensorflow/tfjs": "^4.22.0",
    "@tensorflow/tfjs-backend-wasm": "^4.22.0",
    "@tensorflow/tfjs-backend-webgpu": "^4.22.0",
    "@tensorflow/tfjs-layers": "^4.22.0",
    "@use-gesture/react": "^10.3.1",
    "figlet": "^1.11.0",
    "idb": "^8.0.3",
    "jsfive": "^0.4.0",
    "jszip": "^3.10.1",
    "lodash.throttle": "^4.1.1",
    "next": "^16.2.10",
    "npyjs": "^1.1.0",
    "r3f-forcegraph": "^1.1.1",
    "react": "^19.2.7",
    "react-dom": "^19.2.7",
    "react-headroom": "^3.2.1",
    "three": "^0.185.1",
    "three-stdlib": "^2.36.1",
    "tunnel-rat": "^0.1.2",
    "zustand": "^5.0.14"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "^4.3.2",
    "@tensorflow/tfjs-node": "^4.22.0",
    "@testing-library/dom": "^10.4.1",
    "@testing-library/react": "^16.3.2",
    "@types/figlet": "^1.7.0",
    "@types/lodash.throttle": "^4.1.9",
    "@types/node": "^25.9.5",
    "@types/react": "^19.2.17",
    "@types/react-dom": "^19.2.3",
    "@types/react-headroom": "^3.2.3",
    "@types/three": "^0.185.1",
    "@vitejs/plugin-react": "^6.0.3",
    "commit-and-tag-version": "^12.7.3",
    "eslint": "^10.6.0",
    "fake-indexeddb": "^6.2.5",
    "happy-dom": "^20.10.6",
    "lefthook": "^2.1.10",
    "oxfmt": "^0.58.0",
    "oxlint": "^1.73.0",
    "patch-package": "^8.0.1",
    "postcss": "^8.5.16",
    "puppeteer": "^25.3.0",
    "tailwindcss": "^4.3.2",
    "typescript": "^6.0.3",
    "vite": "^8.1.4",
    "vitest": "^4.1.10"
  },
  "packageManager": "pnpm@11.11.0",
  "postcss": {
    "plugins": {
      "@tailwindcss/postcss": {}
    }
  }
