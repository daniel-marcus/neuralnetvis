{
  "name": "neuralnetvis",
  "version": "0.1.4",
  "private": true,
  "description": "Wrap your head around neural networks and watch machines learn",
  "author": "Daniel Marcus (https://danielmarcus.de)",
  "license": "MIT",
  "homepage": "https://neuralnetvis.app",
  "repository": "https://github.com/daniel-marcus/neuralnetvis",
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "serve": "npx serve out",
    "lint": "eslint .",
    "lint:summary": "eslint . --format summary",
    "check-types": "tsc --noEmit",
    "format": "prettier --write src",
    "test": "vitest --run",
    "test:watch": "vitest",
    "setup-puppeteer": "pnpm dlx puppeteer browsers install",
    "screenshot": "node --import @swc-node/register/esm-register scripts/screenshot.ts",
    "analyze": "next experimental-analyze",
    "postinstall": "lefthook install",
    "commit": "cz commit",
    "bump": "commit-and-tag-version --no-verify",
    "changelog": "commit-and-tag-version --dry-run"
  },
  "dependencies": {
    "@deck.gl/core": "^9.2.11",
    "@deck.gl/extensions": "^9.2.11",
    "@deck.gl/layers": "^9.2.11",
    "@deck.gl/react": "^9.2.11",
    "@mediapipe/drawing_utils": "^0.3.1675466124",
    "@mediapipe/hands": "^0.4.1675469240",
    "@mediapipe/tasks-vision": "0.10.32",
    "@react-spring/web": "^10.0.3",
    "@react-three/drei": "^10.7.7",
    "@react-three/fiber": "^9.5.0",
    "@tensorflow/tfjs": "^4.22.0",
    "@tensorflow/tfjs-backend-wasm": "^4.22.0",
    "@tensorflow/tfjs-backend-webgpu": "^4.22.0",
    "@tensorflow/tfjs-layers": "^4.22.0",
    "@use-gesture/react": "^10.3.1",
    "figlet": "^1.10.0",
    "idb": "^8.0.3",
    "jsfive": "^0.4.0",
    "jszip": "^3.10.1",
    "lodash.throttle": "^4.1.1",
    "next": "^16.1.6",
    "npyjs": "^1.1.0",
    "r3f-forcegraph": "^1.1.1",
    "react": "^19.2.4",
    "react-dom": "^19.2.4",
    "react-headroom": "^3.2.1",
    "three": "^0.183.2",
    "three-stdlib": "^2.36.1",
    "tunnel-rat": "^0.1.2",
    "zustand": "^5.0.11"
  },
  "devDependencies": {
    "@eslint/eslintrc": "^3.3.5",
    "@react-spring/types": "^10.0.3",
    "@swc-node/register": "^1.11.1",
    "@tailwindcss/postcss": "^4.2.1",
    "@tensorflow/tfjs-node": "^4.22.0",
    "@testing-library/dom": "^10.4.1",
    "@testing-library/react": "^16.3.2",
    "@types/figlet": "^1.7.0",
    "@types/lodash.throttle": "^4.1.9",
    "@types/node": "^25.3.5",
    "@types/react": "^19.2.14",
    "@types/react-dom": "^19.2.3",
    "@types/react-headroom": "^3.2.3",
    "@types/three": "^0.183.1",
    "@vitejs/plugin-react": "^5.1.4",
    "commit-and-tag-version": "^12.6.1",
    "eslint": "^9.39.4",
    "eslint-config-next": "^16.1.6",
    "eslint-formatter-summary": "^2.0.2",
    "fake-indexeddb": "^6.2.5",
    "happy-dom": "^20.8.3",
    "lefthook": "^2.1.3",
    "patch-package": "^8.0.1",
    "postcss": "^8.5.8",
    "prettier": "^3.8.1",
    "puppeteer": "^24.38.0",
    "tailwindcss": "^4.2.1",
    "terser-webpack-plugin": "^5.3.17",
    "typescript": "^5.9.3",
    "vite-tsconfig-paths": "^6.1.1",
    "vitest": "^4.0.18"
  },
  "keywords": [
    "data-visualization",
    "machine-learning",
    "neural-network",
    "tensorflow",
    "threejs",
    "react",
    "webgl",
    "webgpu"
  ],
  "prettier": {
    "semi": false
  },
  "packageManager": "pnpm@10.30.1",
  "pnpm": {
    "onlyBuiltDependencies": [
      "@swc/core",
      "@tailwindcss/oxide",
      "@tensorflow/tfjs-node",
      "core-js",
      "esbuild",
      "oxc-resolver",
      "puppeteer",
      "sharp",
      "unrs-resolver"
    ]
  },
  "postcss": {
    "plugins": {
      "@tailwindcss/postcss": {}
    }
  }
}
